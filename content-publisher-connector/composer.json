{
    "name": "cpub/connector",
    "description": "Client-side plugin: lets a WordPress site grant our Publisher scoped OAuth 2 access.",
    "version": "0.5.0",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "ext-json": "*",
        "league/oauth2-server": "^9.4",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "CPub\\Connector\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "CPub\\Connector\\Vendor\\",
            "classmap_prefix": "CPub_Connector_Vendor_",
            "constant_prefix": "CPUB_CONNECTOR_VENDOR_",
            "delete_vendor_packages": true
        }
    }
}
