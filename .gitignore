# ------------------------------------------------------------------
# NOTE: vendor-prefixed/ (both plugins), content-publisher/lib/ and
# content-publisher/build/ are generated, but committed so a fresh clone
# runs without building. Regenerate them with bin/build.sh (see BUILDING.md);
# `bin/build.sh check` confirms the committed copies match the sources.
# Don't edit them by hand.
# ------------------------------------------------------------------

# Dependency folders and build tools
node_modules/
/vendor/
content-publisher/vendor/
content-publisher-connector/vendor/
/.build-tools/

# Local development (dev/README.md): generated secrets and certificates
/dev/.env
/dev/certs/

# Secrets & local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
auth.json
wp-config.php
wp-config-local.php

# Packaged plugin releases / archives
*.zip
*.tar
*.tar.gz
*.tgz
/dist/
/release/

# Logs, caches, temp files
*.log
debug.log
*.cache
.phpunit.result.cache
.phpcs-cache
.php-cs-fixer.cache
.eslintcache
*.tmp
*.bak
*.swp
*~

# Local test / tooling config overrides
phpunit.xml
phpcs.xml.local
coverage/
.phpunit.cache/

# Local WordPress / database dumps
*.sql
*.sqlite
uploads/

# Editor / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# Claude Code local settings
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Local test library path (TESTING.md: running without wp-env)
/.wp-tests.env
